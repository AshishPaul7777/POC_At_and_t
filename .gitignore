# ==============================================================================
# Salesforce Org Cleanup Analyzer
#
# A note on syntax, because getting it wrong here leaks credentials: git treats
# "#" as a comment ONLY at the start of a line. A trailing comment becomes part
# of the pattern, so "orgs.json  # secrets" matches a file literally named that
# and lets the real orgs.json through. Every comment below is on its own line.
# ==============================================================================

# ---- Secrets: never commit ---------------------------------------------------
# Broad on purpose. .env.production and .env.vm are real files people create on
# a server, and neither would be caught by an exact ".env" rule.
.env
.env.*
!.env.example
!.env.production.example

# Per-org Connected App client secrets. orgs.example.json is the template.
orgs.json

secrets/
*.key
*.pem
*.p12
*.jks
*.crt

# The sf CLI's auth store: access and refresh tokens for every org you log into.
.sf/
.sfdx/

# ---- Retrieved org metadata --------------------------------------------------
# WORKSPACE_DIR lands here. Hundreds of files of a customer's Apex, Flows and
# layouts -- their code, not ours, and regenerated by the retrieve stage.
.cache/
workspace/
mdapi_out/
force-app/
manifest/destructive/
*.zip

# Database dumps from deploy/manage.sh backup: the whole analysis, org data
# included.
backups/

# ---- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- Node / Vite ---------------------------------------------------------------
node_modules/
dist/
build/
.vite/
*.tsbuildinfo
vite.config.*.timestamp-*
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Generated artifacts -------------------------------------------------------
# Reports the app produces. The templates that generate them are tracked; their
# output is not.
reports/
*.xlsx
*.pdf
destructiveChanges.xml

# Deck build output. build.js is tracked and regenerates all of it; the .pptx
# itself is deliberately NOT ignored, because it is the deliverable.
deck/qa.html
deck/thumbnails*.jpg
deck/slide-*.jpg
deck/*.pptx.bak

# ---- Logs and scratch ----------------------------------------------------------
*.log
.uvicorn.log
*.tmp
*.bak
*.orig
*.rej

# ---- Set-aside git repositories -------------------------------------------------
# backend/ and frontend/ each used to be their own repository, which made the
# root repo record them as empty gitlinks: a clone would have contained no
# source at all. Their .git directories were renamed rather than deleted, and
# are ignored here so the leftovers do not get committed.
.git.disabled-*

# ---- Editors and OS ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.iml
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json

# Claude Code: launch.json describes how to start the dev server and is worth
# sharing. settings.local.json is one developer's permission choices.
.claude/settings.local.json
.claude/worktrees/
.claude/*.local.*

# Generated by `npm run rebrand-report` from a source bundle that is not in
# this repository. 280KB of machine-written HTML with a client's data in it:
# rebuild it rather than committing it.
frontend/public/executive-report.html
