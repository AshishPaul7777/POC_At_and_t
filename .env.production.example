# ==============================================================================
# Production environment — copy to .env on the VM and fill in.
#
#   cp .env.production.example .env && chmod 600 .env
#
# .env is gitignored and read by both docker compose (for the database
# password) and the backend container. Anything not set here falls back to the
# defaults in backend/app/config.py.
#
# Values the compose file overrides for you, so leave them out:
#   DATABASE_URL, REDIS_URL, WORKSPACE_DIR, SF_CLI_PATH, API_HOST, API_PORT
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE                                                        [REQUIRED]
# ------------------------------------------------------------------------------
# Postgres is not published to the host, so this password guards the compose
# network rather than the internet — but generate a real one anyway:
#   openssl rand -base64 24
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=sfcleanup

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION                                                   [REQUIRED]
# ------------------------------------------------------------------------------
# The UI and the whole API sit behind a sign-in. These three decide whether you
# can get in at all, so set them before the first deploy.

# Signs the session cookie. Generate a fresh one and keep it secret:
#     openssl rand -hex 32
# Changing it signs everyone out; leaving it empty makes the backend invent one
# per process, so every restart signs everyone out and two workers disagree.
AUTH_SECRET_KEY=

# The account that always exists. It is re-applied from these values on every
# boot, which doubles as the password reset: edit here, restart, sign in.
# It cannot be demoted, disabled or deleted from the admin panel.
AUTH_SUPERUSER_EMAIL=hritik.khatri@bounteous.com
AUTH_SUPERUSER_PASSWORD=

# Hours a session stays valid before requiring a fresh sign-in.
AUTH_SESSION_HOURS=12

# ------------------------------------------------------------------------------
# 3. HTTP
# ------------------------------------------------------------------------------
# Host port nginx binds. Use 8080 if something already owns 80, then put a
# reverse proxy in front for TLS.
HTTP_PORT=80

# The API, published on the host as well as proxied through nginx. Useful for
# curl, /docs, and anything driving the API directly. The UI does not use it --
# the browser always goes through nginx, same-origin.
API_PORT_PUBLISHED=8000
API_BIND=0.0.0.0

# Postgres on the host, for psql and backup tooling. The backend does NOT use
# this -- it reaches the database as `postgres:5432` on the compose network, so
# you can change or remove this port without touching the application.
#
# Bound to loopback on purpose. A published Docker port bypasses ufw (Docker's
# DNAT rules run before ufw filters), so "ufw deny 5432" is not the protection
# it appears to be. Reach it over SSH instead:
#
#     ssh -L 5432:127.0.0.1:5432 user@vm
#
# Only set DB_BIND to a real interface if you need the database from another
# host, and restrict it in your cloud security group when you do.
DB_PORT_PUBLISHED=5432
DB_BIND=127.0.0.1

# Only needed if you serve the UI from a different origin than the API. With
# the bundled nginx the browser sees one origin and this is unused.
CORS_ORIGINS=

# ------------------------------------------------------------------------------
# 4. SALESFORCE CONNECTION                                            [REQUIRED]
# ------------------------------------------------------------------------------
# Connected App with BOTH switches on, or the token request fails whatever the
# credentials say:
#   a) App Manager > your app > Edit > OAuth Settings > Enable Client Credentials Flow
#   b) App Manager > your app > Manage > Edit Policies > Client Credentials Flow
#      > assign a "Run As" user       (omitting this yields invalid_grant)
#
# The Run As user bounds what the analysis can see. Anything invisible to that
# user is indistinguishable from something genuinely unused, so a System
# Administrator is strongly recommended.
SF_AUTH_FLOW=client_credentials
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Your My Domain host. Client-credentials tokens are only ever issued from
# here, never from login.salesforce.com.
SF_INSTANCE_URL=https://YOUR-DOMAIN.my.salesforce.com
SF_API_VERSION=67.0

# ------------------------------------------------------------------------------
# 5. API RATE-LIMIT GOVERNOR
# ------------------------------------------------------------------------------
# Calls never consumed, so the org stays usable by humans while a run is live.
SF_API_SAFETY_FLOOR=1500
SF_CLIENT_TIMEOUT_SECONDS=15
SF_MAX_CONCURRENT_SHORT=10
SF_MAX_CONCURRENT_LONG=4
SF_COMPOSITE_BATCH_SIZE=25
SF_COMPOSITE_COMPRESSION_DEFAULT=1.0

# ------------------------------------------------------------------------------
# 6. LLM                                                              [REQUIRED]
# ------------------------------------------------------------------------------
# Powers the narration stage and the assistant. Set LLM_ENABLED=false to run
# the analysis without either; verdicts are unaffected, since no model ever
# decides one.
LLM_ENABLED=true
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Corporate gateway in front of the provider. LLM_BASE_URL wins over the
# provider-specific variable; prefer it, because an ANTHROPIC_BASE_URL exported
# in a shell silently outranks the one in this file and is painful to debug.
# LLM_BASE_URL=https://gateway.example.com

LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4000
LLM_MAX_CONCURRENCY=5
LLM_TIMEOUT_SECONDS=120

# ------------------------------------------------------------------------------
# 7. ANALYSIS TUNING
# ------------------------------------------------------------------------------
ANALYSIS_RECENT_CHANGE_DAYS=90
ANALYSIS_EXCLUDE_NAMESPACED=true
# Asks Salesforce itself whether a delete would be permitted. Validate-only —
# it cannot delete anything — and the most authoritative signal available.
ANALYSIS_ENABLE_DELETE_REHEARSAL=true
ANALYSIS_REHEARSAL_BATCH_SIZE=50
ANALYSIS_ENABLE_SFGE=false
ANALYSIS_COMPLETENESS_THRESHOLD=1.0

# ------------------------------------------------------------------------------
# 8. RUNTIME
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
SSE_HEARTBEAT_SECONDS=15
EVENT_RING_MAX=5000
EVENT_CHANNEL=sfc_events
