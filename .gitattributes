# Line endings.
#
# Everything runs on Windows for development and in Linux containers for
# deployment, so the two must agree. Anything the container executes is pinned
# to LF: a shell script checked out with CRLF fails as
# "/bin/sh^M: bad interpreter", and entrypoint.sh failing that way means the
# backend container never starts.

* text=auto

*.sh            text eol=lf
*.Dockerfile    text eol=lf
Dockerfile      text eol=lf
*.conf          text eol=lf
*.sql           text eol=lf
.env.example        text eol=lf
.env.production.example text eol=lf

*.cmd           text eol=crlf
*.bat           text eol=crlf

# Binary: never normalise, never diff as text.
*.pptx  binary
*.xlsx  binary
*.pdf   binary
*.png   binary
*.jpg   binary
*.ico   binary
