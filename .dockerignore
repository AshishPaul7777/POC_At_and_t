# Keep the build context small and the images clean.
#
# The two that matter most: .venv holds Windows-built binaries that would break
# a Linux image if copied, and .cache can be hundreds of megabytes of retrieved
# org metadata that belongs in a volume, not in a layer.

.venv/
backend/.venv/
**/__pycache__/
**/*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

node_modules/
frontend/node_modules/
frontend/dist/
**/*.tsbuildinfo

.cache/
backups/
**/.uvicorn.log

# Secrets never enter an image. The backend reads .env at runtime via
# compose's env_file, so baking it in would only leak it.
.env
.env.*
!.env.example
!.env.production.example
orgs.json

.git/
.gitignore
.claude/
deck/node_modules/
deck/*.pptx
deck/*.pdf
deck/*.jpg
deck/qa.html
*.md
!README.md
