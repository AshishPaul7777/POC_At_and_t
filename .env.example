# ==============================================================================
# Salesforce Org Cleanup Analyzer — environment template
#
#   cp .env.example .env      then fill in the five REQUIRED values below.
#   .env is gitignored. This file is committed and must never contain secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SALESFORCE CONNECTION                                          [REQUIRED]
# ------------------------------------------------------------------------------
# This block configures ONE org. To analyse several, create orgs.json instead
# (see orgs.example.json) and leave these blank.
#
# Nothing about the org is assumed by the code. Edition, API allowance, Event
# Monitoring availability, Dependency API coverage and endpoint routing are all
# DISCOVERED per org by `python scripts/probe_org.py` and cached. Point this at
# any org and it adapts.
#
# Client Credentials flow needs two switches ON in the Connected App, or the
# token request fails no matter how correct the credentials are:
#   a) App Manager > your app > Edit > OAuth Settings > "Enable Client Credentials Flow"
#   b) App Manager > your app > Manage > Edit Policies > Client Credentials Flow
#      > assign a "Run As" user   (omitting this yields invalid_grant)
#
# The Run As user's permissions bound what the analysis can see. Anything
# invisible to that user looks exactly like something genuinely unused, so a
# System Administrator is strongly recommended.
SF_AUTH_FLOW=client_credentials
SF_CLIENT_ID=                     # <<< Consumer Key from the Connected App
SF_CLIENT_SECRET=                 # <<< Consumer Secret

# Your org's My Domain host. Client-credentials tokens are issued only from
# here, never from login.salesforce.com.
SF_INSTANCE_URL=https://YOUR-DOMAIN.my.salesforce.com
SF_API_VERSION=67.0

# Absolute path to the Salesforce CLI. `sf` is often not on PATH, and multiple
# installs can drift in version. Used only for `project retrieve` and
# `project deploy --dry-run`; all other calls go through the Python client.
#   Windows: C:\Users\<you>\AppData\Roaming\npm\sf.cmd
#   macOS/Linux: /usr/local/bin/sf
SF_CLI_PATH=sf

# ------------------------------------------------------------------------------
# 2. API RATE-LIMIT GOVERNOR
# ------------------------------------------------------------------------------
# Never consume below this many remaining calls, so the org stays usable by
# humans and other tools while a run is in flight.
SF_API_SAFETY_FLOOR=1500

# The 5-concurrent ceiling applies only to requests exceeding 20s. A hard 15s
# client timeout keeps every normal call out of that class entirely.
SF_CLIENT_TIMEOUT_SECONDS=15
SF_MAX_CONCURRENT_SHORT=10
SF_MAX_CONCURRENT_LONG=4          # leaves 1 of 5 slots free for interactive use

# Composite batching. A batch does NOT cost one API call, contrary to most
# documentation — each subrequest carries a real cost. The exact ratio proved too
# noisy to measure cheaply (samples ranged 0.36x to 9x on the same org), so the
# conservative 1:1 assumption below is used unless probe_org.py --deep measures a
# stable value. This only affects the pre-flight ESTIMATE; live budget accounting
# reconciles against the Sforce-Limit-Info header on every response.
# There is no 5-query sublimit on /composite/batch (unlike /composite).
SF_COMPOSITE_BATCH_SIZE=25
SF_COMPOSITE_COMPRESSION_DEFAULT=1.0

# ------------------------------------------------------------------------------
# 3. LLM  (LangChain init_chat_model — provider-agnostic)         [REQUIRED]
# ------------------------------------------------------------------------------
# LLM_PROVIDER must match a LangChain provider id: anthropic | openai |
# google_genai | azure_openai | bedrock_converse | ollama ...
# Set ONLY the API key matching your chosen provider; leave the rest blank.
LLM_ENABLED=true
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5

ANTHROPIC_API_KEY=                # <<< if LLM_PROVIDER=anthropic
OPENAI_API_KEY=                   # if LLM_PROVIDER=openai
GOOGLE_API_KEY=                   # if LLM_PROVIDER=google_genai

# Corporate gateway / proxy in front of the provider. Resolution order:
#   1. LLM_BASE_URL          explicit override, applies to any provider
#   2. ANTHROPIC_BASE_URL    (or OPENAI_BASE_URL) the provider's standard var
#   3. the provider's public endpoint
#
# These are also read from the shell environment if not set here, so an existing
# exported ANTHROPIC_BASE_URL works without duplication. Note that a variable
# exported in your interactive shell is not always visible to tooling that runs
# in a different session — set it here if a run reports the wrong base_url.
#
# ANTHROPIC_BASE_URL=https://gateway.example.com
# LLM_BASE_URL=https://gateway.example.com
#
# If a provider's client rejects base_url, the run logs
# `llm_base_url_unsupported` and retries WITHOUT it rather than failing. Watch
# for that warning: silently falling back would send traffic to the public
# endpoint, which may be blocked or non-compliant.

# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=

# Temperature 0 is deliberate: the LLM narrates a verdict the rule engine has
# already decided. It must not be creative, and it never classifies.
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4000
LLM_MAX_CONCURRENCY=5
LLM_TIMEOUT_SECONDS=120
# Rate-limit backoff for narration: sleep * 2^attempt, up to N retries.
LLM_RATE_LIMIT_RETRIES=3
LLM_RATE_LIMIT_SLEEP_SECONDS=15

# ------------------------------------------------------------------------------
# 4. INFRASTRUCTURE  (defaults work as-is under docker compose)
# ------------------------------------------------------------------------------
# Docker Postgres 16 (docker compose up -d postgres redis).
# Host ports are shifted to 5433/6380 so they do not collide with a local
# PostgreSQL on 5432. The schema auto-applies on first boot from
# backend/db/schema.sql, mounted into docker-entrypoint-initdb.d.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/sfcleanup
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sfcleanup

# Redis is running and available, but event fan-out currently uses Postgres
# LISTEN/NOTIFY on channel 'sfc_events'. Notifications are wake-ups only -- the
# events table is the source of truth, so a dropped one costs nothing.
REDIS_URL=redis://127.0.0.1:6380/0
EVENT_CHANNEL=sfc_events

# Fallback: the local PostgreSQL 15 setup used before Docker was available.
# Create it with backend/db/bootstrap.sql if you ever need it.
# DATABASE_URL=postgresql+asyncpg://sfcleanup:sfcleanup_local_dev@127.0.0.1:5432/sfcleanup

API_HOST=0.0.0.0
API_PORT=8000
APEXD_URL=http://apexd:7000          # Node ANTLR sidecar (apex-parser)

# Where retrieved Salesforce metadata is written. KEEP THIS RELATIVE: a relative
# value is resolved against the repo root by Settings.workspace, whereas an
# absolute POSIX path like /workspace resolves to the DRIVE ROOT on Windows and
# the retrieve stage then writes several hundred files to C:\.
# Inside a container, mount the sf_workspace named volume here instead -- a
# Windows bind mount through WSL2 is pathologically slow for this file shape.
WORKSPACE_DIR=./.cache/workspace

# Browser origin allowed to open the SSE stream.
CORS_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------------------
# 5. ANALYSIS TUNING
# ------------------------------------------------------------------------------
# Components changed within this window are flagged RECENTLY_CHANGED and capped
# at NEEDS_REVIEW — half-built features look exactly like dead ones.
ANALYSIS_RECENT_CHANGE_DAYS=90

# Managed-package components cannot be deleted, so they are marked OUT_OF_SCOPE
# rather than classified. They are still indexed as a reference source.
ANALYSIS_EXCLUDE_NAMESPACED=true

# Ask Salesforce itself whether a delete is permitted. The single most
# authoritative signal available — a refusal names the blocking reference.
ANALYSIS_ENABLE_DELETE_REHEARSAL=true
ANALYSIS_REHEARSAL_BATCH_SIZE=50

# Graph Engine is Developer Preview, OOM-prone, and blind to Flow/VF/LWC
# callers. Off by default; corroboration only, never a primary signal.
ANALYSIS_ENABLE_SFGE=false
SFGE_MAX_HEAP=4g
SFGE_TIMEOUT_SECONDS=900

# Minimum fraction of required collectors that must complete successfully before
# a component may be classified UNUSED. Below this the completeness gate fails
# and the verdict is forced to NEEDS_REVIEW.
ANALYSIS_COMPLETENESS_THRESHOLD=1.0

# ------------------------------------------------------------------------------
# 6. RUNTIME
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
SSE_HEARTBEAT_SECONDS=15
EVENT_RING_MAX=5000               # Redis Streams MAXLEN per run

# ------------------------------------------------------------------------------
# AUTHENTICATION                                                            
# ------------------------------------------------------------------------------
# The UI and the whole API sit behind a sign-in. These three decide whether you
# can get in at all, so set them before the first deploy.

# Signs the session cookie. Generate a fresh one and keep it secret:
#     openssl rand -hex 32
# Changing it signs everyone out; leaving it empty makes the backend invent one
# per process, so every restart signs everyone out and two workers disagree.
AUTH_SECRET_KEY=

# The account that always exists. It is re-applied from these values on every
# boot, which doubles as the password reset: edit here, restart, sign in.
# It cannot be demoted, disabled or deleted from the admin panel.
AUTH_SUPERUSER_EMAIL=hritik.khatri@bounteous.com
AUTH_SUPERUSER_PASSWORD=

# Hours a session stays valid before requiring a fresh sign-in.
AUTH_SESSION_HOURS=12
